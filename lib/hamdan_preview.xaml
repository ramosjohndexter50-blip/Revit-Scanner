<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Hamdan - Review changes" Width="1040" Height="650" WindowStartupLocation="CenterScreen" Background="#F3F6FA">
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="Review changes" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="status_text" TextWrapping="Wrap" Margin="0,8,0,16"/></StackPanel>
  <DataGrid Grid.Row="1" x:Name="preview" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="260"/><DataGridTextColumn Header="Field" Binding="{Binding Field}" Width="160"/><DataGridTextColumn Header="Current" Binding="{Binding Old}" Width="240"/><DataGridTextColumn Header="Proposed" Binding="{Binding New}" Width="240"/></DataGrid.Columns></DataGrid>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0"><Button Content="Back" Padding="20,9" Click="cancel_clicked" Margin="0,0,8,0"/><Button Content="Apply changes" Padding="20,9" Background="#175CD3" Foreground="White" Click="apply_clicked"/></StackPanel>
 </Grid>
</Window>
