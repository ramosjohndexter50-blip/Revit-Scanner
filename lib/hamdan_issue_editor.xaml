<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Hamdan - Issue tracking" Width="780" Height="780" WindowStartupLocation="CenterScreen" Background="#F3F6FA">
 <Window.Resources><Style TargetType="TextBox"><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,4,0,10"/></Style></Window.Resources>
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="Issue tracking" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="finding" TextWrapping="Wrap" Margin="0,8,0,12"/><TextBlock Text="Workflow status does not prove a clash disappeared. Approval or manual resolution requires a reason." TextWrapping="Wrap" Foreground="#475569" Margin="0,0,0,12"/></StackPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="Status"/><ComboBox x:Name="status_box" Padding="8" Margin="0,4,0,10"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Assignee"/><TextBox x:Name="assignee_box"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Due date (YYYY-MM-DD)"/><TextBox x:Name="due_box"/></StackPanel></Grid>
  <StackPanel Grid.Row="2"><TextBlock Text="Reason / approval justification"/><TextBox x:Name="reason_box" AcceptsReturn="True" Height="65" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></StackPanel>
  <StackPanel Grid.Row="3"><TextBlock Text="New comment (appends to history)"/><TextBox x:Name="comment_box" AcceptsReturn="True" Height="65" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></StackPanel>
  <Grid Grid.Row="4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="History"/><TextBox x:Name="history_box" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></Grid>
  <StackPanel Grid.Row="5" Margin="0,12,0,0"><TextBlock x:Name="error_text" TextWrapping="Wrap" Foreground="#B42318"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" Padding="18,9" Margin="0,8,8,0" Click="cancel_clicked"/><Button Content="Save tracking" Padding="18,9" Margin="0,8,0,0" Background="#175CD3" Foreground="White" Click="save_clicked"/></StackPanel></StackPanel>
 </Grid>
</Window>
