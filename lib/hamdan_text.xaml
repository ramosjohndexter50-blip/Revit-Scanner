<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="960" Height="720" WindowStartupLocation="CenterScreen" Background="#F3F6FA">
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock x:Name="heading" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="help_text" TextWrapping="Wrap" Margin="0,8,0,16"/></StackPanel><TextBox x:Name="editor" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" FontSize="13" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0"><Button Content="Cancel" Click="cancel_clicked" Padding="20,9" Margin="0,0,8,0"/><Button Content="Save" Click="save_clicked" Padding="20,9" Background="#175CD3" Foreground="White"/></StackPanel></Grid>
</Window>
